    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Calculate counts of 'yes' and 'no' per month\n",
    "month_counts = df.groupby(['month', 'y']).size().unstack(fill_value=0)\n",
    "\n",
    "# Convert counts to proportions\n",
    "month_props = month_counts.div(month_counts.sum(axis=1), axis=0)\n",
    "\n",
    "# Sort months in calendar order\n",
    "month_order = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec']\n",
    "month_props = month_props.reindex(month_order)\n",
    "\n",
    "# Plot stacked bar chart\n",
    "ax = month_props.plot(kind='bar', stacked=True, figsize=(12,6), color=['#FF9999','#99CCFF'])\n",
    "\n",
    "# Annotate percentages on bars\n",
    "for i, month in enumerate(month_props.index):\n",
    "    bottom = 0\n",
    "    for y_value in month_props.columns:\n",
    "        prop = month_props.loc[month, y_value]\n",
    "        if prop > 0:\n",
    "            ax.text(i, bottom + prop/2, f'{prop*100:.1f}%', ha='center', va='center', fontsize=9, color='black')\n",
    "            bottom += prop\n",
    "\n",
    "plt.title(\"Proportion of 'y' by Month with Percentages\")\n",
    "plt.ylabel(\"Proportion\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.legend(title='y', loc='lower right', labels=['No','Yes'])\n",
    "plt.xticks(rotation=45)\n",
    "plt.ylim(0,1)\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "plt.show()\n"
   ]
  },
