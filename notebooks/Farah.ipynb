    "    plt.figure(figsize=(12, 5))\n",
    "\n",
    "    # Boxplot split by y\n",
    "    plt.subplot(1, 2, 1)\n",
    "    sns.boxplot(x='y', y=col, data=df)\n",
    "    plt.title(f'Boxplot of {col} by y')\n",
    "\n",
